    "environment.weather_sensitivity": {"value":1,"confidence":0.95,"review_status":"confirmed","rationale":"야외 해상 레저라 바람·파고·강수 등 해상 기상 조건이 이용 가능성과 안전에 직접 영향을 준다.","source_ids":["visitjeju-woljeong-kayak","ktriptips-woljeong-kayak"]},
    "style_evidence.restfulness": {"value":0.75,"confidence":0.78,"review_status":"confirmed","rationale":"공식 안내가 바다 위를 떠다니며 여유를 만끽하는 체험으로 소개하고, 관광 안내도 한적하고 여유로운 곳이라고 설명한다.","source_ids":["visitjeju-woljeong-kayak","ktriptips-woljeong-kayak"]},
    "style_evidence.physical_ease": {"value":0.5,"confidence":0.65,"review_status":"confirmed","rationale":"수심이 깊지 않고 물결이 잔잔하며 초보자 이용과 안전요원 배치를 안내하지만, 직접 노를 젓는 수상 활동이므로 높은 신체 편의로 보지 않는다.","source_ids":["visitjeju-woljeong-kayak","ktriptips-woljeong-kayak"]},
    "style_evidence.visit_duration_flexibility": {"value":0.5,"confidence":0.35,"review_status":"needs_review","rationale":"운영시간만 확인됐고 예약 단위·체험 시간·현장 대기 조건의 공식 근거가 부족하다. 중립값을 유지한다.","source_ids":["ktriptips-woljeong-kayak"],"hold_reason":"체험 회차와 소요시간 미확인"},
    "style_evidence.scenic_value": {"value":1,"confidence":0.9,"review_status":"confirmed","rationale":"공식 관광 안내가 에메랄드빛 제주 바다를 만끽하는 체험으로 소개하며, 투명한 바닥으로 바다를 내려다보는 경험이 핵심이다.","source_ids":["visitjeju-woljeong-kayak","ktriptips-woljeong-kayak"]},
    "style_evidence.distinctiveness": {"value":0.75,"confidence":0.78,"review_status":"confirmed","rationale":"일반 카약이 아니라 바닥이 보이는 투명 카약으로 월정 바다를 관찰하는 방식이 방문 경험의 뚜렷한 차별점이다.","source_ids":["visitjeju-woljeong-kayak","ktriptips-woljeong-kayak"]},
    "style_evidence.local_embeddedness": {"value":0.25,"confidence":0.6,"review_status":"confirmed","rationale":"월정리 해안이라는 제주 현지 자연환경에 직접 결합한 독립 장소이지만, 확인한 출처에는 제주 고유 문화·생업·유산을 해석하거나 체험하는 근거가 없다. 다지역 프랜차이즈라는 근거도 찾지 못했다.","source_ids":["visitjeju-woljeong-kayak","ktriptips-woljeong-kayak"]},
    "style_evidence.landmark_significance": {"value":0.25,"confidence":0.7,"review_status":"confirmed","rationale":"월정해변 풍경을 즐기는 체험장이나, 이 사업장 자체가 제주를 대표하는 랜드마크라는 공공·공식 지정 또는 서술은 확인되지 않았다.","source_ids":["visitjeju-woljeong-kayak","ktriptips-woljeong-kayak"]},
