    "style_evidence.scenic_value":{"value":1,"confidence":1,"review_status":"confirmed","rationale":"한라산·마라도·제주 남쪽 바다·푸른 바다를 한눈에 보는 전망대라는 직접 근거가 있다.","source_ids":["gapado-official","jeju-council-magazine"]},
