  "atomic_labels": {
    "theme.mountain":{"value":0,"confidence":0.9,"review_status":"confirmed","rationale":"공공·관광 공식 정보에서 산행·산악 자연 체험을 방문 핵심으로 제시하지 않는다.","source_ids":["jeju-public-accessibility","jeju-city-tour"]},
    "theme.ocean":{"value":0,"confidence":0.9,"review_status":"confirmed","rationale":"해안·바다 경험이 아닌 내륙 저지문화예술인마을의 미술관이다.","source_ids":["jeju-public-accessibility","jeju-city-tour"]},
    "theme.activity":{"value":0.25,"confidence":0.75,"review_status":"confirmed","rationale":"예술 걷기·야외 조각공원·교육 프로그램은 있으나 능동적 활동형 장소가 아니라 전시 관람 중심이다.","source_ids":["jeju-city-tour"]},
    "theme.culture_history":{"value":1,"confidence":0.95,"review_status":"confirmed","rationale":"지자체가 지역 문화예술 진흥을 위해 개관한 공공 현대미술관으로 전시·자료·아틀리에·교육을 운영한다.","source_ids":["jeju-city-tour","jeju-public-accessibility"]},
    "theme.theme_park":{"value":0,"confidence":0.95,"review_status":"confirmed","rationale":"놀이기구나 테마파크형 체험이 아닌 공공 미술관이다.","source_ids":["jeju-public-accessibility","jeju-city-tour"]},
    "theme.cafe":{"value":0,"confidence":0.9,"review_status":"confirmed","rationale":"아트숍은 부대시설이며 카페가 방문 주목적인 장소라는 근거가 없다.","source_ids":["jeju-public-accessibility","jeju-city-tour"]},
    "theme.traditional_market":{"value":0,"confidence":0.95,"review_status":"confirmed","rationale":"전시·공연·교육 시설로 확인되며 전통시장 기능은 없다.","source_ids":["jeju-city-tour"]},
    "theme.festival":{"value":0.25,"confidence":0.8,"review_status":"confirmed","rationale":"야외공연장과 문화행사는 가능하지만 상시 미술관이 핵심이고 축제가 장소의 주목적은 아니다.","source_ids":["jeju-city-tour"]},
    "environment.indoor_ratio":{"value":0.75,"confidence":0.9,"review_status":"confirmed","rationale":"실내·야외 복합이지만 상설·기획 전시실이 핵심이며 공식 관광 정보도 실내관광지로 분류한다.","source_ids":["jeju-public-accessibility","visitjeju-detail"]},
    "environment.weather_sensitivity":{"value":0.25,"confidence":0.9,"review_status":"confirmed","rationale":"사계절 이용 가능하고 우천시 관람 가능하나 야외 조각공원·휴게공간은 날씨 영향을 받는다.","source_ids":["jeju-city-tour","jeju-public-accessibility"]},
    "style_evidence.restfulness":{"value":0.75,"confidence":0.75,"review_status":"confirmed","rationale":"저지문화예술인마을의 전시 관람과 야외 휴게·조각공원 경험은 저강도이고, 자연과 예술을 함께 향유하는 공간으로 소개된다.","source_ids":["jeju-city-tour","jeju-public-accessibility"]},
    "style_evidence.physical_ease":{"value":0.75,"confidence":0.8,"review_status":"confirmed","rationale":"무장애 접근로, 단차 없는 출입구, 엘리베이터, 휠체어·유아차가 제공되나 일부 야외 경사로는 주의가 필요하다.","source_ids":["jeju-public-accessibility","jeju-city-tour"]},
    "style_evidence.visit_duration_flexibility":{"value":0.75,"confidence":0.7,"review_status":"confirmed","rationale":"전시실뿐 아니라 야외 조각공원·자료실·아틀리에를 선택적으로 볼 수 있고 종일 운영하나, 개별 전시 관람에는 통상적 운영시간 제약이 있다.","source_ids":["jeju-city-tour","jeju-public-accessibility"]},
    "style_evidence.scenic_value":{"value":0.75,"confidence":0.75,"review_status":"confirmed","rationale":"보전된 중산간 저지리의 예술인마을에 있으며 야외 조각공원과 자연·예술 결합 경관이 공식 소개된다.","source_ids":["jeju-city-tour","jeju-public-accessibility"]},
    "style_evidence.distinctiveness":{"value":0.75,"confidence":0.8,"review_status":"confirmed","rationale":"제주 공공 현대미술관이 저지문화예술인마을·야외조각공원·수장고·아틀리에를 결합한 구성으로 확인된다.","source_ids":["jeju-public-accessibility","jeju-city-tour"]},
    "style_evidence.local_embeddedness":{"value":0.75,"confidence":0.9,"review_status":"confirmed","rationale":"제주특별자치도가 지역 문화예술 진흥을 위해 운영하며 저지문화예술인마을 중심부에 위치해 제주 지역 문화 생태계와 직접 연결된다.","source_ids":["jeju-public-accessibility","jeju-city-tour"]},
    "style_evidence.landmark_significance":{"value":0.75,"confidence":0.75,"review_status":"confirmed","rationale":"제주관광공사 공식 페이지가 제주7대건축물·공영관광지로 분류하고, 지자체 공공 문화시설로 지역 문화관광 거점 역할이 확인된다.","source_ids":["visitjeju-detail","jeju-city-tour"]},
    "style_evidence.photo_value":{"value":0.75,"confidence":0.75,"review_status":"confirmed","rationale":"제주관광공사 공식 페이지가 포토스팟으로 태그하고, 야외 조각공원·건축·예술인마을 경관이 존재한다.","source_ids":["visitjeju-detail","jeju-public-accessibility"]}
