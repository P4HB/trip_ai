    "theme.traditional_market":{"value":0,"confidence":0.95,"review_status":"confirmed","rationale":"전통시장 또는 상거래 공간이 아니라 카라반 숙박 시설이다.","source_ids":["gocamping"]},
    "theme.festival":{"value":0,"confidence":0.9,"review_status":"confirmed","rationale":"상설 숙박 시설로 확인되며 축제 프로그램 근거가 없다.","source_ids":["kto-place"]},
    "environment.indoor_ratio":{"value":0.5,"confidence":0.75,"review_status":"confirmed","rationale":"카라반·펜션 내부에 침대·주방·냉난방 등 실내 체류 설비가 있으나, 해안 캠핑장·오션뷰의 야외 환경도 핵심이다.","source_ids":["kto-place","gocamping"]},
    "environment.weather_sensitivity":{"value":0.5,"confidence":0.65,"review_status":"confirmed","rationale":"냉난방을 갖춘 실내 숙박공간이 있어 전면 야외 활동보다 날씨 영향은 낮지만, 해안 캠핑·오션뷰 체류 특성상 날씨와 무관하지 않다.","source_ids":["kto-place","gocamping"]},
    "style_evidence.restfulness":{"value":0.75,"confidence":0.75,"review_status":"confirmed","rationale":"침대·소파·냉난방을 갖춘 숙박과 오션뷰·자쿠지 독채 안내는 휴식 중심 체류를 뒷받침한다.","source_ids":["kto-place"]},
    "style_evidence.physical_ease":{"value":0.5,"confidence":0.3,"review_status":"needs_review","hold_reason":"보행거리, 경사, 객실 접근성, 무장애 설비의 장소별 근거를 확인하지 못했다.","rationale":"실내 숙박 설비는 확인되지만 이동 난이도를 사실로 단정할 근거가 부족해 중립값을 유지한다.","source_ids":["kto-place"]},
    "style_evidence.visit_duration_flexibility":{"value":0.25,"confidence":0.65,"review_status":"confirmed","rationale":"예약·체크인 기반의 펜션·카라반 숙박 시설이므로 짧은 자유 방문보다 숙박 단위 이용 성격이 강하다.","source_ids":["kto-place","tamnao"]},
    "style_evidence.scenic_value":{"value":0.75,"confidence":0.85,"review_status":"confirmed","rationale":"함덕해수욕장과 제주바다가 눈앞에 펼쳐지는 위치, 오션뷰 숙박이 공공·지자체 안내에 명시된다.","source_ids":["kto-place","gocamping","tamnao"]},
    "style_evidence.distinctiveness":{"value":0.25,"confidence":0.55,"review_status":"confirmed","rationale":"해안 오션뷰 카라반이라는 특성은 있으나, 고유한 건축·문화·자연 자산이나 독자 체험이 확인되지 않아 제한적으로 평가한다.","source_ids":["kto-place","gocamping"]},
    "style_evidence.local_embeddedness":{"value":0.5,"confidence":0.45,"review_status":"needs_review","hold_reason":"제주 지역 기반 운영·지역 문화 또는 지역 생산물 연계 여부를 입증할 공식 운영자 자료를 찾지 못했다.","rationale":"제주 함덕 해안 경관에 직접 위치한 독립 숙박 시설임은 확인되지만, 위치 사실만으로 강한 제주 로컬성을 단정하지 않는다.","source_ids":["gocamping","tamnao"]},
    "style_evidence.landmark_significance":{"value":0,"confidence":0.85,"review_status":"confirmed","rationale":"공공 관광 안내에서 함덕해수욕장은 주변 명소로 언급되지만 무거카라반 자체를 지역 랜드마크로 소개하지 않는다.","source_ids":["kto-place","gocamping"]},
    "style_evidence.photo_value":{"value":0.75,"confidence":0.8,"review_status":"confirmed","rationale":"제주바다·함덕해수욕장이 눈앞에 펼쳐지는 해안 위치와 오션뷰가 공식·공공 안내에 명시되어 경관 촬영 가치가 높다.","source_ids":["kto-place","gocamping","tamnao"]}
