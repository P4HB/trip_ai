    "theme.mountain":{"value":0,"confidence":0.9,"review_status":"confirmed","rationale":"공공 안내는 함덕 해안과 카라반 숙박을 중심으로 설명하며 산악 방문 경험 근거가 없다.","source_ids":["kto-place","gocamping"]},
    "theme.ocean":{"value":0.75,"confidence":0.9,"review_status":"confirmed","rationale":"함덕해수욕장이 눈앞에 보이는 해안도로 위치와 오션뷰 숙박이 공공·지자체 플랫폼에서 확인된다.","source_ids":["kto-place","gocamping","tamnao"]},
    "theme.activity":{"value":0.25,"confidence":0.7,"review_status":"confirmed","rationale":"카라반·캠핑 숙박은 야외 체류 성격이 있으나, 별도의 체험·레저 프로그램이 확인되지는 않는다.","source_ids":["kto-place","gocamping"]},
    "theme.culture_history":{"value":0,"confidence":0.85,"review_status":"confirmed","rationale":"문화·역사 체험을 제공한다는 근거가 없다.","source_ids":["kto-place"]},
