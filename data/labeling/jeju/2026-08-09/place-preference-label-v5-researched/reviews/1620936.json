    "theme.ocean":{"value":0,"confidence":0.9,"review_status":"confirmed","rationale":"해안 인접 동선은 별도 산책길에 포함될 수 있으나, 이중섭거리 자체의 방문 주제는 해양 경험이 아니다.","source_ids":["visitjeju-ijungseop-street","seogwipo-cultural-walk"]},
    "theme.activity":{"value":0.25,"confidence":0.75,"review_status":"confirmed","rationale":"거리 걷기와 공방 탐방은 가능하지만 스포츠·야외활동형 목적지는 아니다.","source_ids":["visitjeju-ijungseop-street","jeju-cultural-architecture-walk"]},
    "theme.culture_history":{"value":1,"confidence":0.95,"review_status":"confirmed","rationale":"피난 시절 이중섭의 거주지와 미술관을 중심으로 조성된 문화거리라는 직접 근거가 있다.","source_ids":["visitjeju-ijungseop-street","seogwipo-cultural-walk"]},
    "theme.theme_park":{"value":0,"confidence":0.95,"review_status":"confirmed","rationale":"문화거리·공방·미술관 주변 공간으로 소개되며 테마파크 시설 근거가 없다.","source_ids":["visitjeju-ijungseop-street"]},
    "theme.cafe":{"value":0.25,"confidence":0.75,"review_status":"confirmed","rationale":"카페가 일부 모여 있다는 설명은 있으나 거리의 주된 정체성은 문화·예술 거리이지 카페 방문 자체가 아니다.","source_ids":["jeju-cultural-architecture-walk"]},
    "theme.traditional_market":{"value":0,"confidence":0.9,"review_status":"confirmed","rationale":"공방과 창작 스튜디오 중심 문화거리로 설명되며 전통시장이라는 근거가 없다.","source_ids":["visitjeju-ijungseop-street","jeju-cultural-architecture-walk"]},
    "theme.festival":{"value":0.25,"confidence":0.65,"review_status":"confirmed","rationale":"시민 창작자의 예술시장이 지속적으로 열린 이력은 있으나 상시 방문 목적을 축제로 보기는 어렵다.","source_ids":["jeju-cultural-architecture-walk"]},
    "environment.indoor_ratio":{"value":0.25,"confidence":0.7,"review_status":"confirmed","rationale":"핵심은 보행 문화거리이며 미술관·공방·카페 등 실내 선택지가 병존한다.","source_ids":["visitjeju-ijungseop-street","jeju-cultural-architecture-walk"]},
    "environment.weather_sensitivity":{"value":0.75,"confidence":0.7,"review_status":"confirmed","rationale":"거리 보행·공방 탐방이 주요 경험이므로 비·강풍 시 야외 이동 경험의 영향이 크다.","source_ids":["visitjeju-ijungseop-street","jeju-cultural-architecture-walk"]},
    "style_evidence.restfulness":{"value":0.5,"confidence":0.65,"review_status":"confirmed","rationale":"산책과 예술 감상 성격은 있으나 공방·상점이 모인 원도심 문화거리여서 전적으로 고요한 휴식형은 아니다.","source_ids":["visitjeju-ijungseop-street","jeju-cultural-architecture-walk"]},
    "style_evidence.physical_ease":{"value":0.5,"confidence":0.25,"review_status":"needs_review","hold_reason":"보행 경사, 단차, 무장애 시설에 관한 장소 단위 공식 근거를 확인하지 못했다.","rationale":"보행 문화거리라는 사실만으로 접근 난이도를 확정하지 않고 중립값을 유지한다.","source_ids":["seogwipo-cultural-walk"]},
    "style_evidence.visit_duration_flexibility":{"value":0.75,"confidence":0.75,"review_status":"confirmed","rationale":"거리 산책만 할 수도 있고 거주지·미술관·공방·카페를 조합할 수도 있어 체류 길이 선택 폭이 있다.","source_ids":["visitjeju-ijungseop-street","jeju-cultural-architecture-walk"]},
    "style_evidence.scenic_value":{"value":0.5,"confidence":0.55,"review_status":"confirmed","rationale":"자연 경관보다 원도심 예술·보행 풍경이 중심이다. 공공 자료가 시각 경관 명소로 직접 평정하지 않아 중간값으로 둔다.","source_ids":["visitjeju-ijungseop-street","jeju-cultural-architecture-walk"]},
    "style_evidence.distinctiveness":{"value":1,"confidence":0.9,"review_status":"confirmed","rationale":"특정 화가의 실제 피난 거주지와 미술관을 중심으로 형성된 문화거리라는 고유한 정체성이 명확하다.","source_ids":["visitjeju-ijungseop-street","seogwipo-cultural-walk"]},
    "style_evidence.local_embeddedness":{"value":1,"confidence":0.9,"review_status":"confirmed","rationale":"서귀포 원도심의 이중섭 거주 역사, 시민 창작자 예술시장, 지역 공방·창작 스튜디오에 기반한 장소다.","source_ids":["seogwipo-cultural-walk","jeju-cultural-architecture-walk"]},
    "style_evidence.landmark_significance":{"value":0.75,"confidence":0.8,"review_status":"confirmed","rationale":"서귀포시의 작가의 산책길과 원도심 문화관광 동선의 핵심 지점으로 공식 소개된다.","source_ids":["seogwipo-cultural-walk","visitjeju-ijungseop-street"]},
