    "theme.activity":{"value":0.25,"confidence":0.75,"review_status":"confirmed","rationale":"13.3km 도보 코스로 안내되지만, 스포츠·유료 체험이 주목적인 장소는 아니다.","source_ids":["openjeju"]},
    "theme.culture_history":{"value":0.25,"confidence":0.65,"review_status":"confirmed","rationale":"경로 주변 주요 콘텐츠로 연대·별방진·할망당이 안내되나, 해안도로 자체의 주된 방문 목적은 자연 경관이다.","source_ids":["openjeju"]},
