    "style_evidence.visit_duration_flexibility":{"value":1,"confidence":0.75,"review_status":"confirmed","rationale":"연속된 공공 해안도로여서 전망 지점의 짧은 정차부터 13.3km 전체 도보까지 방문 길이를 조절할 수 있다.","source_ids":["visitjeju","openjeju"]},
    "style_evidence.scenic_value":{"value":1,"confidence":0.95,"review_status":"confirmed","rationale":"백사장·푸른 해변·철새도래지와 철새가 어우러진 자연 경관이 공식 관광 설명의 중심이다.","source_ids":["visitjeju"]},
