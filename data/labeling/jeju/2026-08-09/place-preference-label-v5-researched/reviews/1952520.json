    "theme.activity":{"value":1,"confidence":0.9,"review_status":"confirmed","rationale":"요트체험과 요트낚시, 스노클링이 직접 안내되는 체험형 해양 활동이다.","source_ids":["visitjeju-yacht","official-kakao"]},
