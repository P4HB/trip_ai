    "environment.weather_sensitivity":{"value":1,"confidence":0.85,"review_status":"confirmed","rationale":"해상 승선 체험이며 공공 관광자료가 여름 햇볕 아래의 요트체험을 언급한다. 기상·해상 상태에 영향을 크게 받는다.","source_ids":["visitjeju-yacht","operator-tour"]},
