    "style_evidence.distinctiveness": {"value":0.75,"confidence":0.75,"review_status":"confirmed","rationale":"주인이 직접 지은 삼각 지붕 목조 건물과 밭·돌담 속 입지는 일반 카페와 구별되는 구체적 특징이다.","source_ids":["kto-derived-place-page"]},
    "style_evidence.local_embeddedness": {"value":0.75,"confidence":0.65,"review_status":"confirmed","rationale":"제주 애월 어음리의 밭·돌담 풍경 속에 자리하고 제주 경관과 자연스럽게 녹아든다고 공공 관광정보가 설명한다. 다만 제주산 식재료·지역 운영 주체의 직접 근거는 없어 1점은 부여하지 않는다.","source_ids":["kto-derived-place-page"]},
