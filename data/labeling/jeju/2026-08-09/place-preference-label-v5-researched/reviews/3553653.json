    "theme.festival":{"value":0,"confidence":0.98,"review_status":"confirmed","rationale":"상설 포구·올레길 거점으로 확인되며 축제가 방문의 주된 목적이라는 근거가 없다.","source_ids":["visitjeju-place"]},
