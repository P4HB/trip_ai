    "style_evidence.restfulness":{"value":0.75,"confidence":0.8,"review_status":"confirmed","rationale":"공공 관광자료가 작은 포구와 반농반어 마을의 평온함, 올레꾼의 작은 쉼터를 명시한다.","source_ids":["visitjeju-place","visitjeju-theme"]},
    "style_evidence.physical_ease":{"value":0.75,"confidence":0.6,"review_status":"confirmed","rationale":"포구 관람과 쉼 자체는 평지의 짧은 체류로 가능하나, 연결 올레 전 구간은 장거리이므로 포구 단독 경험에 한정해 평가했다.","source_ids":["visitjeju-place","jejuolle-course"]},
    "style_evidence.visit_duration_flexibility":{"value":0.75,"confidence":0.7,"review_status":"confirmed","rationale":"공공 자료가 올레꾼의 작은 쉼터로 설명하며, 짧은 휴식부터 올레 코스 연결까지 선택 가능하다.","source_ids":["visitjeju-place","jejuolle-course"]},
    "style_evidence.scenic_value":{"value":0.75,"confidence":0.85,"review_status":"confirmed","rationale":"아름다운 해안선과 바다를 품은 작고 아담한 포구의 경관이 공공 관광자료에 명시된다.","source_ids":["visitjeju-theme"]},
    "style_evidence.distinctiveness":{"value":0.75,"confidence":0.9,"review_status":"confirmed","rationale":"현무암 전통 등대 도대가 보존되고 제주에 7개만 남았다는 설명이 차별성을 뒷받침한다.","source_ids":["visitjeju-place"]},
    "style_evidence.local_embeddedness":{"value":1,"confidence":0.95,"review_status":"confirmed","rationale":"온평리 주민의 옛 터전·반농반어 마을 생활과 제주 고유의 현무암 도대가 장소의 핵심 근거다.","source_ids":["visitjeju-place","visitjeju-theme"]},
