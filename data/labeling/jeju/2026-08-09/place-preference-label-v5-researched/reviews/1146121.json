    "theme.ocean":{"value":0,"confidence":0.95,"review_status":"confirmed","rationale":"교래 곶자왈 내륙 테마파크이며 해안·해양 체험 근거가 없다.","source_ids":["visitjeju-place","kto-article"]},
    "theme.activity":{"value":0.5,"confidence":0.8,"review_status":"confirmed","rationale":"기차 탑승과 역별 하차·숲길 걷기 체험이 가능하지만 고강도 레저 시설은 아니다.","source_ids":["kto-article","visitjeju-guidebook"]},
    "theme.culture_history":{"value":0.25,"confidence":0.75,"review_status":"confirmed","rationale":"제주 곶자왈 자연환경을 해설하는 성격은 있으나 역사·문화유산 관람이 주된 목적이라는 근거는 약하다.","source_ids":["kto-article","visitjeju-place"]},
    "theme.theme_park":{"value":1,"confidence":1,"review_status":"confirmed","rationale":"제주관광공사와 한국관광공사가 모두 기차 기반 테마파크로 직접 소개한다.","source_ids":["visitjeju-place","kto-article"]},
    "theme.cafe":{"value":0,"confidence":0.9,"review_status":"confirmed","rationale":"주요 방문 목적은 곶자왈·기차 테마파크 체험이며 카페가 장소의 주제라는 근거는 없다.","source_ids":["visitjeju-place","kto-article"]},
    "theme.traditional_market":{"value":0,"confidence":0.95,"review_status":"confirmed","rationale":"시장·상거래 시설이 아니라 유료 자연 체험형 테마파크다.","source_ids":["visitjeju-place","kto-article"]},
    "theme.festival":{"value":0,"confidence":0.85,"review_status":"confirmed","rationale":"상설 테마파크로 소개되며 특정 축제가 방문의 본질이라는 근거는 없다.","source_ids":["visitjeju-place","kto-article"]},
    "environment.indoor_ratio":{"value":0.25,"confidence":0.8,"review_status":"confirmed","rationale":"공공 자료가 곶자왈·호수·역별 풍경·숲길의 야외 체험을 중심으로 설명한다. 실내 매표·편의공간은 있으나 체험 대부분은 야외다.","source_ids":["visitjeju-place","kto-article"]},
    "environment.weather_sensitivity":{"value":0.75,"confidence":0.85,"review_status":"confirmed","rationale":"야외 곶자왈 기차와 역별 하차·걷기, 계절별 녹음·억새·설경을 핵심 경험으로 제시하므로 날씨 영향이 크다.","source_ids":["visitjeju-place","kto-article","visitjeju-guidebook"]},
    "style_evidence.restfulness":{"value":0.75,"confidence":0.8,"review_status":"confirmed","rationale":"숲 기차 탑승과 호수 풍경 감상·걷기 중심의 저강도 자연 체험이다.","source_ids":["kto-article","visitjeju-guidebook"]},
    "style_evidence.physical_ease":{"value":0.75,"confidence":0.65,"review_status":"confirmed","rationale":"역 사이를 기차로 이동할 수 있어 장거리 전 구간을 도보로 이동할 필요는 없지만, 풍경 감상 코스에는 하차 후 걷기가 포함된다.","source_ids":["kto-article"]},
    "style_evidence.visit_duration_flexibility":{"value":1,"confidence":0.8,"review_status":"confirmed","rationale":"다섯 역에서 원하는 곳에 내려 각 역의 풍경을 즐기는 구조라 짧은 탑승부터 하차·산책을 포함한 체류까지 조절 가능하다.","source_ids":["kto-article"]},
    "style_evidence.scenic_value":{"value":0.75,"confidence":0.9,"review_status":"confirmed","rationale":"곶자왈 원시림, 호수 풍경과 사계절 녹음·억새·설경이 공공 관광 자료에 핵심 경관으로 소개된다.","source_ids":["visitjeju-place","kto-article","visitjeju-guidebook"]},
    "style_evidence.distinctiveness":{"value":0.75,"confidence":0.85,"review_status":"confirmed","rationale":"제주 중산간 곶자왈 생태를 약 4.5km 숲 기차와 다섯 역으로 체험하게 한 구성은 일반 공원과 구별된다.","source_ids":["kto-article","visitjeju-guidebook"]},
    "style_evidence.local_embeddedness":{"value":0.75,"confidence":0.85,"review_status":"confirmed","rationale":"체험의 핵심이 제주 교래 곶자왈·중산간 원시림이라는 장소 고유 생태이며, 제주 밖으로 쉽게 대체되지 않는 자연환경에 직접 의존한다.","source_ids":["visitjeju-place","kto-article","visitjeju-guidebook"]},
    "style_evidence.landmark_significance":{"value":0.75,"confidence":0.75,"review_status":"confirmed","rationale":"제주관광공사 공식 가이드북과 한국관광공사가 대표 곶자왈 체험 테마파크로 별도 소개한다. 다만 국가 지정 유산·상징물이라는 직접 근거는 확인하지 못했다.","source_ids":["kto-article","visitjeju-guidebook"]},
    "style_evidence.photo_value":{"value":0.75,"confidence":0.8,"review_status":"confirmed","rationale":"호수 풍경, 곶자왈 숲, 계절별 녹음·억새·설경이 공식 관광 자료에서 주요 볼거리로 소개되어 경관 촬영 소재가 뚜렷하다.","source_ids":["visitjeju-place","kto-article"]}
