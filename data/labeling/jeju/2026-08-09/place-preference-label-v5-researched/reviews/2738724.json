    "theme.ocean":{"value":0.75,"confidence":0.9,"review_status":"confirmed","rationale":"공원 옆 소남머리에서 주상절리 해안가를 조망할 수 있다는 제주관광공사 소개가 있다.","source_ids":["visitjeju-artpark"]},
    "theme.activity":{"value":0.25,"confidence":0.8,"review_status":"confirmed","rationale":"문화예술 트레킹 코스의 경유지이므로 가벼운 보행 활동은 가능하나, 별도 체험·스포츠 시설은 확인되지 않았다.","source_ids":["jeju-dsi-accessibility"]},
    "theme.culture_history":{"value":0.75,"confidence":0.9,"review_status":"confirmed","rationale":"이중섭을 기억하고 그 영향권 예술가 작품으로 조성된 문화예술공원이며 작가의 산책길 경유지다.","source_ids":["visitjeju-artpark","jeju-dsi-accessibility"]},
    "theme.theme_park":{"value":0,"confidence":0.95,"review_status":"confirmed","rationale":"공공 소개상 자연·예술 공원이지 유료 놀이기구 또는 테마파크 시설이 아니다.","source_ids":["visitjeju-artpark"]},
    "theme.cafe":{"value":0,"confidence":0.9,"review_status":"confirmed","rationale":"장소의 핵심 기능이 공원·산책·예술 작품 관람이며 카페 운영 근거가 없다.","source_ids":["visitjeju-artpark"]},
    "theme.traditional_market":{"value":0,"confidence":0.95,"review_status":"confirmed","rationale":"공원이며 전통시장 기능 근거가 없다.","source_ids":["visitjeju-artpark"]},
