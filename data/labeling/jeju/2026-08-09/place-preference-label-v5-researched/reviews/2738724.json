    "environment.weather_sensitivity":{"value":0.75,"confidence":0.8,"review_status":"confirmed","rationale":"주요 경험이 야외 공원, 해안 조망, 보행이므로 비·강풍의 영향을 받는다.","source_ids":["visitjeju-artpark","jeju-dsi-accessibility"]},
    "style_evidence.restfulness":{"value":0.75,"confidence":0.8,"review_status":"confirmed","rationale":"예술 작품이 있는 공원과 해안 조망, 산책길이라는 성격이 짧은 휴식·느린 보행에 적합하다.","source_ids":["visitjeju-artpark","jeju-dsi-accessibility"]},
    "style_evidence.physical_ease":{"value":0.5,"confidence":0.7,"review_status":"confirmed","rationale":"일반 공원 보행은 가능하지만, 바다 방향 내리막 구간은 휠체어 이용자에게 주의가 필요하다고 공공 접근성 안내가 명시한다.","source_ids":["jeju-dsi-accessibility"]},
    "style_evidence.visit_duration_flexibility":{"value":0.75,"confidence":0.75,"review_status":"confirmed","rationale":"공원 산책 및 작품 감상은 짧은 경유부터 산책길 연계까지 체류 시간을 조절할 수 있다.","source_ids":["visitjeju-artpark","jeju-dsi-accessibility"]},
    "style_evidence.scenic_value":{"value":0.75,"confidence":0.9,"review_status":"confirmed","rationale":"소남머리에서 주상절리가 펼쳐진 해안가를 볼 수 있다는 공공 관광 소개가 있다.","source_ids":["visitjeju-artpark"]},
    "style_evidence.distinctiveness":{"value":0.75,"confidence":0.85,"review_status":"confirmed","rationale":"이중섭을 기리는 예술 작품과 해안 지질 경관이 결합된 공원이라는 점이 일반 근린공원과 구별된다.","source_ids":["visitjeju-artpark"]},
    "style_evidence.local_embeddedness":{"value":0.75,"confidence":0.85,"review_status":"confirmed","rationale":"서귀포 원도심 송산동의 장소로, 제주 화가 이중섭을 기리는 지역 예술 맥락과 마을 공동체 행사가 공공 관광 자료에서 확인된다.","source_ids":["visitjeju-artpark","visitjeju-songsa"]},
