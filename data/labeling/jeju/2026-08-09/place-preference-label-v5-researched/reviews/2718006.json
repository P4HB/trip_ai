  "atomic_labels": {
    "theme.mountain":{"value":0,"confidence":0.9,"review_status":"confirmed","rationale":"공식·공공 소개는 도심 호텔 숙박과 객실·편의시설을 설명하며 산 체험을 제공하지 않는다.","source_ids":["official-about","kto-open-tourism"]},
    "theme.ocean":{"value":0,"confidence":0.85,"review_status":"confirmed","rationale":"일부 객실의 오션뷰는 확인되지만, 이 장소 자체의 방문 목적은 해양·해변 활동이 아닌 숙박이다.","source_ids":["official-about","kto-open-tourism"]},
    "theme.activity":{"value":0.25,"confidence":0.7,"review_status":"confirmed","rationale":"피트니스센터가 있으나 숙박이 주기능이고 독립적인 활동형 관광지는 아니다.","source_ids":["kto-open-tourism"]},
    "theme.culture_history":{"value":0,"confidence":0.9,"review_status":"confirmed","rationale":"공식·공공 설명에서 문화유산·역사 체험 또는 전시 기능을 확인하지 못했다.","source_ids":["official-about","kto-open-tourism"]},
    "theme.theme_park":{"value":0,"confidence":0.95,"review_status":"confirmed","rationale":"호텔·레지던스 시설로 소개되며 테마파크형 놀이·전시 시설 근거가 없다.","source_ids":["official-about","kto-open-tourism"]},
    "theme.cafe":{"value":0,"confidence":0.9,"review_status":"confirmed","rationale":"공식·공공 자료에서 카페가 이 장소의 주된 방문 테마라는 근거를 확인하지 못했다.","source_ids":["official-about","kto-open-tourism"]},
    "theme.traditional_market":{"value":0,"confidence":0.95,"review_status":"confirmed","rationale":"전통시장·상점가 운영 장소가 아니라 숙박시설이다.","source_ids":["official-about","kto-open-tourism"]},
    "theme.festival":{"value":0,"confidence":0.95,"review_status":"confirmed","rationale":"상설 숙박시설이며 축제가 방문 목적이라는 근거가 없다.","source_ids":["official-about","kto-open-tourism"]},
    "environment.indoor_ratio":{"value":1,"confidence":0.95,"review_status":"confirmed","rationale":"객실·피트니스·워시룸·미팅룸으로 이용되는 호텔 건물이다.","source_ids":["kto-open-tourism"]},
    "environment.weather_sensitivity":{"value":0.25,"confidence":0.9,"review_status":"confirmed","rationale":"주요 이용 공간이 실내여서 날씨가 방문 경험을 크게 좌우하지 않는다. 오션뷰는 부가 객실 특성이다.","source_ids":["official-about","kto-open-tourism"]},
    "style_evidence.restfulness":{"value":0.75,"confidence":0.85,"review_status":"confirmed","rationale":"호텔 숙박과 구스다운 침구가 휴식 목적에 직접 부합한다.","source_ids":["official-about","kto-open-tourism"]},
    "style_evidence.physical_ease":{"value":1,"confidence":0.9,"review_status":"confirmed","rationale":"장애인용 엘리베이터, 단차 없는 주출입구, 휠체어 대여, 장애인 객실·화장실·주차구역이 공공 관광정보에 확인된다.","source_ids":["kto-open-tourism"]},
    "style_evidence.visit_duration_flexibility":{"value":0.75,"confidence":0.8,"review_status":"confirmed","rationale":"호텔·레지던스 숙박은 체크인 후 휴식·객실 체류를 중심으로 하며, 단기 숙박부터 연박까지 이용 시간이 비교적 유연하다.","source_ids":["official-about","kto-open-tourism"]},
    "style_evidence.scenic_value":{"value":0.25,"confidence":0.75,"review_status":"confirmed","rationale":"오션뷰 객실은 있으나 공공 소개의 핵심은 숙박·스마트 편의시설이고 경관 감상이 장소의 주된 체험으로 확인되지는 않는다.","source_ids":["official-about","kto-open-tourism"]},
    "style_evidence.distinctiveness":{"value":0.5,"confidence":0.75,"review_status":"confirmed","rationale":"자동객실관리시스템을 활용하는 친환경 스마트 호텔이라는 분명한 차별 특성이 있으나, 제주 대표 명소급 고유성 근거는 없다.","source_ids":["kto-open-tourism"]},
    "style_evidence.local_embeddedness":{"value":0.25,"confidence":0.55,"review_status":"confirmed","rationale":"제주시 소재 독립 숙박시설임은 확인되지만 제주 고유 문화·생산물·지역 공동체를 핵심 체험으로 제공한다는 근거는 찾지 못했다. 다지역 체인 여부를 단정할 공식 근거도 없다.","source_ids":["official-about","kto-open-tourism"]},
    "style_evidence.landmark_significance":{"value":0,"confidence":0.8,"review_status":"confirmed","rationale":"공식·공공 관광 소개에서 지역 랜드마크·대표 관광명소로서의 위상은 확인되지 않는다.","source_ids":["official-about","kto-open-tourism"]},
    "style_evidence.photo_value":{"value":0.25,"confidence":0.6,"review_status":"confirmed","rationale":"오션뷰 객실은 사진 요소가 될 수 있으나, 공식·공공 자료에 사진 명소 또는 시각 경험 중심 장소라는 근거는 없다.","source_ids":["official-about","kto-open-tourism"]}
