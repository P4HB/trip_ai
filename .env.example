KTO_TOUR_API_KEY=your_data_go_kr_service_key

# 동선·식당 후보 (SPEC-107/108). 아래 키 중 하나만 넣으면 `python scripts/run_trip_ai_local.py`로 바로 동작합니다.
# 이 파일은 값 없는 템플릿입니다. 실제 키는 .env에만 넣으세요(.env는 AI 열람 금지, SPEC-109).
# Gemini: 무료(미결제) 키 입력은 Google 제품 개선·사람 검토에 쓰일 수 있어 결제 연결 프로젝트 키를 권장합니다.
GEMINI_API_KEY=
OPENAI_API_KEY=
# 선택: 공급자 auto(기본, 키가 하나면 그 공급자, 둘 다 있으면 openai) | gemini | openai
# LLM_PROVIDER=gemini
# 선택: 시간표·식당 판정 모델 (비우면 gemini-3.8-flash / gpt-5.6-terra, 식당 판정은 시간표 모델과 같음)
# ITINERARY_LLM_MODEL=gemini-3.8-flash
# RESTAURANT_LLM_MODEL=gemini-3.5-flash-lite
# 선택: Gemini 사고 수준 (비우면 모델 기본값)
# GEMINI_THINKING_LEVEL=low
# 선택: 이동시간 공급자 estimate(기본, 외부 호출 없음) | kakao(KAKAO_MOBILITY_API_KEY 필요)
# ITINERARY_ROUTE_PROVIDER=estimate
